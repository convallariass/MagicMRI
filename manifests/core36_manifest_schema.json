{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/convallariass/MagicMRI/blob/main/manifests/core36_manifest_schema.json",
  "title": "MagicMRI Core-36 inference/evaluation manifest row",
  "type": "object",
  "additionalProperties": false,
  "required": ["sample_id", "task_id", "patient_id", "slice_id", "slice_index", "exemplar_source", "exemplar_target", "query_source", "query_target"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "patient_id": {"type": "string", "minLength": 1, "description": "A local pseudonymous identifier; do not publish patient identifiers."},
    "slice_id": {"type": "string", "minLength": 1},
    "slice_index": {"type": "integer", "minimum": 0},
    "exemplar_source": {"type": "string", "minLength": 1},
    "exemplar_target": {"type": "string", "minLength": 1},
    "query_source": {"type": "string", "minLength": 1},
    "query_target": {"type": "string", "minLength": 1},
    "prediction_path": {"type": "string", "minLength": 1, "description": "Added by inference; omitted from input bindings."}
  }
}
